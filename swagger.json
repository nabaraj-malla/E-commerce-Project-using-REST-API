{
  "openapi": "3.0.0",
  "info": {
    "title": "E-Commerce Platform APIs",
    "description": "RESTful web APIs that provides an e-commerce functionality, covering user management (signup, signin, profile updates, password reset), product lifecycle (creation, retrieval, modification, deletion, categorization, rating, filtration), cart management (adding,retrieve,removing items), and order management.  \nNOTE: don't change key part only change value part during testing  \nNOTE: Try with your own value for all APIs available",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://e-commerce-project-using-rest-api.onrender.com/"
    }
  ],
  "components": {
    "securitySchemes": {
      "JWT": {
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "paths": {
    "/api/users/signup": {
      "post": {
        "tags": ["Users"],
        "summary": "user registration",
        "description": "NOTE: valid user type = Cutomer, Vendor  \nProvide one of above type in user signup's 'type' field",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "IamUser"
                  },
                  "email": {
                    "type": "string",
                    "example": "iamuser@test.com [must end with test.com]"
                  },
                  "password": {
                    "type": "string",
                    "example": "iAmuser@123"
                  },
                  "address": {
                    "type": "string",
                    "example": "Pokhara"
                  },
                  "type": {
                    "type": "string",
                    "example": "Customer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "resource created"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/users/signin": {
      "post": {
        "tags": ["Users"],
        "summary": "Authenticate user credentials",
        "description": "Enables existing users to log in using their email and password and receives token to authorize to test other apis",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "iamuser@test.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "iAmuser@123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/users/updateProfile": {
      "put": {
        "tags": ["Users"],
        "summary": "update your profile",
        "description": "Allows authenticated users to update their personal details such as name, address",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "IamNewUser"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "Vendor"
            }
          },
          {
            "name": "address",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "Zero k.m"
            }
          }
        ],
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/users/resetPassword": {
      "put": {
        "tags": ["Users"],
        "summary": "Reset user password",
        "description": "Allows user to reset their password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newPassword": {
                    "type": "string",
                    "example": "newPassword@45"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/products/add": {
      "post": {
        "tags": ["Products"],
        "summary": "Add a new product",
        "description": "Allows authorized users to create and list new products with details such as name, price, and category  \nAvailable categories for now, Electronics = 66afb53be55e7b9ba87d9b45, Clothing = 66afb53be55e7b9ba87d9b46, Sports = 66afb53be55e7b9ba87d9b44  \nProvide one or more id for categories field seperated by commas",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "MacBook"
                  },
                  "price": {
                    "type": "number",
                    "format": "float",
                    "example": 225000
                  },
                  "categories": {
                    "type": "string",
                    "example": "66afb53be55e7b9ba87d9b45"
                  },
                  "desc": {
                    "type": "string",
                    "example": "Mac is so popular and should be considered for your coding activities"
                  },
                  "sizes": {
                    "type": "string",
                    "example": "13-inch,15-inch"
                  },
                  "inStock": {
                    "type": "number",
                    "example": 15
                  },
                  "imageURL": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": ["name", "price", "sizes", "imageURL", "inStock"]
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Get All products",
        "description": "Fetches a list of all available products on the platform",
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },

    "/api/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get a product by ID",
        "description": " Retrieves detailed information about a specific product based on its unique identifier",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "66bf84f03506cee46ae8f0de"
            }
          }
        ],
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/products/filter": {
      "post": {
        "tags": ["Products"],
        "summary": "Get a product based on filter",
        "description": "Provides options to search and filter products based on attributes like category, price range, and rating",
        "parameters": [
          {
            "name": "minPrice",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "float",
              "example": 150000
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "float",
              "example": 250000
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "66afb53be55e7b9ba87d9b45"
            }
          }
        ],
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/products/rate": {
      "post": {
        "tags": ["Products"],
        "summary": "Rate a product",
        "description": "Allows user to submit rating and review to product  \nProvide productId in productID field",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productID": {
                    "type": "string",
                    "example": "66bf84f03506cee46ae8f0de"
                  },
                  "rating": {
                    "type": "number",
                    "format": "float",
                    "example": 8
                  },
                  "text": {
                    "type": "string",
                    "example": "long battery life but needed more ports."
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/products/averageRating/{productId}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product average rating of a product",
        "description": "Calculates and returns the average rating based on all user reviews for a specific product  \nProvide productId in productID field",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "66bf84f03506cee46ae8f0de"
            }
          }
        ],
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/products/addCategory": {
      "post": {
        "tags": ["Products"],
        "summary": "add new product category",
        "description": "Resultant category id will be provided while adding new category.  \ncreate your own category below is for demo purpose.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "example": "food"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/carts/new": {
      "post": {
        "tags": ["Carts"],
        "summary": "Add product to cart",
        "description": "User will add a product to cart by specifying product ID and quantity",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productID": {
                    "type": "string",
                    "example": "66bf84f03506cee46ae8f0de"
                  },
                  "quantity": {
                    "type": "number",
                    "format": "float",
                    "example": 2
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/carts/cartItems": {
      "get": {
        "tags": ["Carts"],
        "summary": "Get cart products",
        "description": "Fetches the list of products currently added to the user's cart",

        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/carts/delete": {
      "delete": {
        "tags": ["Carts"],
        "summary": "Delete cart products of loggedin user",
        "description": "Must provide cartItem id",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cartItemID": {
                    "type": "string",
                    "example": "Provide your cartItem id"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "Receive order details",
        "description": "User will receive order details including product, time and total amount if cart item availabe",

        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  }
}
