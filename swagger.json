{
  "openapi": "3.0.0",
  "info": {
    "title": "E-Commerce Platform APIs",
    "description": "RESTful web APIs that provides an e-commerce functionality, covering user management (signup, signin, profile updates, password reset), product lifecycle (creation, retrieval, modification, deletion, categorization, rating, filtration), cart management (adding,retrieve,removing items), and order management NOTE: don't change key part only change value part during testing",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://e-commerce-project-using-rest-api.onrender.com/"
    }
  ],
  "components": {
    "securitySchemes": {
      "JWT": {
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "paths": {
    "/api/users/signup": {
      "post": {
        "tags": ["Users"],
        "summary": "user registration",
        "description": "NOTE: valid user type = Cutomer, Vendor, Admin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "IamUser"
                  },
                  "email": {
                    "type": "string",
                    "example": "iamuser@test.com [must end with test.com]"
                  },
                  "password": {
                    "type": "string",
                    "example": "iAmuser@123 [password must contain at least one uppercase letter, one lowercase letter, one digit, and one special character and minimum length of 8]"
                  },
                  "address": {
                    "type": "string",
                    "example": "Pokhara"
                  },
                  "type": {
                    "type": "string",
                    "example": "Customer || Vendor"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "resource created"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/users/signin": {
      "post": {
        "tags": ["Users"],
        "summary": "Authenticate user credentials",
        "description": "Enables existing users to log in using their email and password and receives token to authorize to test other apis",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "iamuser@test.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "iAmuser@123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/users/updateProfile": {
      "put": {
        "tags": ["Users"],
        "summary": "update your profile",
        "description": "Allows authenticated users to update their personal details such as name, address",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "IamNewUser"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "Vendor"
            }
          },
          {
            "name": "address",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "Zero k.m"
            }
          }
        ],
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/users/resetPassword": {
      "put": {
        "tags": ["Users"],
        "summary": "Reset user password",
        "description": "Sends a password reset link to the user’s registered email, allowing them to securely reset their password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newPassword": {
                    "type": "string",
                    "example": "newPassword@45"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/products/add": {
      "post": {
        "tags": ["Products"],
        "summary": "Add a product",
        "description": "AVAILABLE CATEGORIES FOE NOW Electronics = 66afb53be55e7b9ba87d9b45, Clothing = 66afb53be55e7b9ba87d9b46 NOTE: can add your own categories",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "price": {
                    "type": "number",
                    "format": "float"
                  },
                  "categories": {
                    "type": "string"
                  },
                  "desc": {
                    "type": "string"
                  },
                  "sizes": {
                    "type": "string"
                  },
                  "inStock": {
                    "type": "number"
                  },
                  "imageURL": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": ["name", "price", "sizes", "imageURL", "inStock"]
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Get products",
        "description": "User will receive all the products",
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },

    "/api/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get a product by ID",
        "description": "User will receive the product",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/products/filter": {
      "post": {
        "tags": ["Products"],
        "summary": "Get a product based on filter",
        "description": "User will receive the filtered products",
        "parameters": [
          {
            "name": "minPrice",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/products/rate": {
      "post": {
        "tags": ["Products"],
        "summary": "Rate a product",
        "description": "User will rate a product",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productID": {
                    "type": "string"
                  },
                  "rating": {
                    "type": "number",
                    "format": "float"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/products/averageRating/{productId}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product average rating",
        "description": "Must provide productId, User will receive rating of each products",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/products/addCategory": {
      "post": {
        "tags": ["Products"],
        "summary": "add new product category",
        "description": "Resultant category id will be provided while adding new category",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/carts/new": {
      "post": {
        "tags": ["Carts"],
        "summary": "Add product to cart",
        "description": "User will add a product to cart",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productID": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number",
                    "format": "float"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/carts/cartItems": {
      "get": {
        "tags": ["Carts"],
        "summary": "Get cart products",
        "description": "Loggedin user will receive their cart products",

        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/carts/delete": {
      "delete": {
        "tags": ["Carts"],
        "summary": "Delete cart products of loggedin user",
        "description": "Must provide cartItem id",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cartItemID": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "Receive order details",
        "description": "User will receive order details",

        "security": [
          {
            "JWT": {}
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  }
}
